#version 450
#extension GL_GOOGLE_include_directive : require
// Enhanced atmosphere LUTs (8d, Hillaire 2020), one pass per define: TRANS transmittance (256x64, Bruneton mapping), MULTI multiple-scattering
// (32x32, 64 directions per texel), SKYV sky-view (192x108, from the camera), AP aerial perspective (32^3 froxels, slice k at ((k+0.5)/32)^2 * far).
// Layout mirrors gX in native/core/enhanced.inl.
#define ENH
#include "frame.glsl"
layout(set = 0, binding = 1) uniform sampler2D Sx[4];             // 0 transmittance, 1 multiple scattering
layout(set = 0, binding = 2, rgba16f) uniform image2D Wx[4];       // 0 transmittance, 1 multiple scattering, 2 sky-view
layout(set = 0, binding = 3, rgba16f) uniform image3D Wv;          // aerial perspective: in-scattered rgb, mean transmittance
#define transLut Sx[0]
#define multiLut Sx[1]
#include "atmo.glsl"
#ifdef MULTI
layout(local_size_x = 64) in;
#else
layout(local_size_x = 8, local_size_y = 8) in;
#endif

#ifdef TRANS
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(TRANS_RES)))) return;
    vec2 x = vec2(p) / (TRANS_RES - 1);
    float Rg = F.atmC.w, Rt = F.atmP.x, H = sqrt(max((Rt - Rg) * (Rt + Rg), 1)), rho = H * x.y, r = sqrt(rho * rho + Rg * Rg);
    float dmin = Rt - r, dmax = rho + H, d = dmin + x.x * (dmax - dmin), mu = d < 1 ? 1 : clamp((H * H - rho * rho - d * d) / (2 * r * d), -1, 1), dt = d / 40;
    vec3 od = vec3(0);
    for (int i = 0; i < 40; i++) {
        float t = (i + 0.5) * dt; vec3 sR, e; float sM;
        medium(sqrt(r * r + t * t + 2 * r * mu * t), sR, sM, e); od += e * dt;
    }
    imageStore(Wx[0], p, vec4(exp(-od), 1));
}
#endif

#ifdef MULTI
// Psi_ms = L2 / (1 - f_ms): second-order light for an isotropic phase, summed over all orders (ground albedo 0.3)
shared vec3 sL[64], sF[64];
void main() {
    ivec2 p = ivec2(gl_WorkGroupID.xy); uint i = gl_LocalInvocationIndex;
    vec2 x = vec2(p) / (MULTI_RES - 1);
    float muS = x.x * 2 - 1, r = F.atmC.w + max(x.y * (F.atmP.x - F.atmC.w), 1);
    vec3 o = vec3(0, r, 0), L = vec3(sqrt(max(1 - muS * muS, 0)), muS, 0);
    float z = 1 - (float(i) + 0.5) / 32, ph = float(i) * 2.39996323;
    vec3 d = vec3(sqrt(max(1 - z * z, 0)) * cos(ph), z, sqrt(max(1 - z * z, 0)) * sin(ph)), Ls = vec3(0), fs = vec3(0), T = vec3(1);
    float t0, t1;
    if (atmSeg(o, d, t0, t1)) {
        float dt = (t1 - t0) / 20;
        for (int k = 0; k < 20; k++) {
            vec3 q = o + d * (t0 + (k + 0.5) * dt); float rq = length(q);
            vec3 sR, e; float sM; medium(rq, sR, sM, e);
            vec3 sc = sR + sM, st = exp(-e * dt), I = T * sc * (1 - st) / max(e, vec3(1e-12));
            float muq = dot(q, L) / rq;
            Ls += I * transmittance(rq, muq) * smoothstep(-0.02, 0.02, muq + sqrt(max(1 - sq(F.atmC.w / rq), 0))) / (4 * PI);
            fs += I;
            T *= st;
        }
        vec3 e = o + d * t1;
        if (length(e) < F.atmC.w + 10) { float mg = dot(normalize(e), L); Ls += T * transmittance(F.atmC.w, mg) * max(mg, 0) * 0.3 / PI; }
    }
    sL[i] = Ls; sF[i] = fs; barrier();
    for (uint h = 32; h > 0; h >>= 1) { if (i < h) { sL[i] += sL[i + h]; sF[i] += sF[i + h]; } barrier(); }
    if (i == 0) imageStore(Wx[1], p, vec4(sL[0] / 64 / max(1 - sF[0] / 64, vec3(1e-3)), 1));
}
#endif

#ifdef SKYV
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(192, 108)))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(192, 108);
    float Rg = F.atmC.w; vec3 o = F.camPos.xyz - F.atmC.xyz;
    float r = clamp(length(o), Rg + 2, F.atmP.x - 1); vec3 up = normalize(o), L = F.lightDir.xyz;
    vec3 f = L - up * dot(up, L);
    f = dot(f, f) > 1e-8 ? normalize(f) : normalize(cross(up, abs(up.x) < 0.9 ? vec3(1, 0, 0) : vec3(0, 1, 0)));
    float vh = sqrt(max((r - Rg) * (r + Rg), 0)), beta = acos(clamp(vh / r, -1, 1)), zha = PI - beta, cz;
    if (uv.y < 0.5) { float c = 1 - 2 * uv.y; cz = cos(zha * (1 - c * c)); }
    else { float c = uv.y * 2 - 1; cz = cos(zha + beta * c * c); }
    float cl = 1 - 2 * uv.x * uv.x, sz = sqrt(max(1 - cz * cz, 0));
    vec3 d = up * cz + sz * (f * cl + cross(up, f) * sqrt(max(1 - cl * cl, 0))), Tr, S = vec3(0);
    float t0, t1;
    if (atmSeg(up * r, d, t0, t1)) S = scatter(up * r, d, t0, t1, 30, Tr);
    imageStore(Wx[2], p, vec4(S * sunE(), 1));
}
#endif

#ifdef AP
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(32)))) return;
    vec2 n = (vec2(p) + 0.5) / 32 * 2 - 1;
    vec3 d = normalize(F.camR.xyz * ((n.x + F.proj.z) / F.proj.x) + F.camU.xyz * ((F.proj.w - n.y) / F.proj.y) + F.camF.xyz);
    vec3 o = F.camPos.xyz - F.atmC.xyz, L = F.lightDir.xyz, E = sunE() / F.atmX.y, S = vec3(0), T = vec3(1);   // physical haze: sky brightness is for the sky only
    float c = dot(d, L), pr = phaseR(c), pm = phaseM(c), tp = 0;
    vec2 g = sphHit(o, d, F.atmC.w); float tg = g.x > 0 ? g.x : 3e38;
    for (int k = 0; k < 32; k++) {
        float t = min(sq((k + 0.5) / 32) * F.atmP.w, tg);
        for (int j = 0; j < 2; j++) {
            float dt = (t - tp) * 0.5; vec3 q = o + d * (tp + (j + 0.5) * dt); float r = length(q);
            vec3 sR, e; float sM; medium(r, sR, sM, e);
            vec3 jj = (sR * pr + sM * pm) * sunTrans(q) + (sR + sM) * multiScat(r, dot(q, L) / r), st = exp(-e * dt);
            S += T * (jj - jj * st) / max(e, vec3(1e-12)); T *= st;
        }
        tp = t;
        imageStore(Wv, ivec3(p, k), vec4(S * E, dot(T, vec3(1.0 / 3))));
    }
}
#endif
